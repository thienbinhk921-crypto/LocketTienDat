#!name=Locket Custom Edition
#!desc=Crack By dỉnhiendat | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 45s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/thienbinhk921-crypto/LocketTienDat/refs/heads/main/Locket.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by dinhtiendat)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thienbinhk921-crypto/LocketTienDat/refs/heads/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 19/10/2005 (by dinhtiendat)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/usatalk/my-script/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60
